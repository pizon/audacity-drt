+    void setAxisChoice(int value) { mAxis = value; }
+
+    int dbRange() const { return dBRange; }
+    void setDbRange(int value) { dBRange = value; }
+
+    double rate() const { return mRate; }
+    size_t dataLen() const { return mDataLen; }
