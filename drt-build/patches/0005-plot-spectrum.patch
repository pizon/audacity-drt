+
+    bool loadAudio();
+    bool recalculate(SpectrumAnalyst::ProgressFn progress = nullptr);
+
+    SpectrumAnalyst* analyst() const { return mAnalyst.get(); }
+
+    bool drawGrid() const { return mDrawGrid; }
+    void setDrawGrid(bool value) { mDrawGrid = value; }
+
